# --- Desarrollo sin Electron (`npm run dev`) ---------------------------------
# Compatibilidad para `npm run dev` sin Electron. No usar para distribuir.
# Base64 es serialización, no cifrado. El widget Electron usa DPAPI y no
# necesita estas variables. La aplicación gestiona sus valores automáticamente.

DASHBOARD_PROVIDER_KEYS=
DASHBOARD_CONFIG=
DASHBOARD_PREFERENCES=

# --- Despliegue Docker (NAS) ---------------------------------------------------
# Obligatorio en Docker: docker-compose lee este valor del .env situado junto a
# docker-compose.yml y no arranca si falta. Mínimo 32 caracteres; generar con
#   openssl rand -hex 32
# Navegador: usuario DASHBOARD_AUTH_USER + contraseña = token (HTTP Basic).
# Sincronizador, extensión y bookmarklet: `Authorization: Bearer <token>`.
# Fuera de Docker (Electron, `npm run dev`) dejarlo vacío desactiva la autenticación.
DASHBOARD_AUTH_TOKEN=
DASHBOARD_AUTH_USER=admin
