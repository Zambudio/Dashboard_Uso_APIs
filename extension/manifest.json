{
  "manifest_version": 3,
  "name": "Dashboard Uso APIs - Sincronizador",
  "version": "1.1.0",
  "description": "Sincroniza automáticamente los límites de uso de ChatGPT, Claude, Gemini y DeepSeek con tu Dashboard en local o NAS.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://platform.deepseek.com/*",
    "http://192.168.*/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sincronizar límites de IAs con Dashboard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://platform.deepseek.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
