{
  "name": "dashboard-uso-apis",
  "version": "0.2.2",
  "description": "Dashboard local para supervisar uso, costes y lÃ­mites reales de proveedores de IA.",
  "private": true,
  "license": "MIT",
  "author": "Pedro Zambudio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zambudio/Dashboard_Uso_APIs.git"
  },
  "bugs": {
    "url": "https://github.com/Zambudio/Dashboard_Uso_APIs/issues"
  },
  "homepage": "https://github.com/Zambudio/Dashboard_Uso_APIs#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test electron/*.test.js electron/lib/*.test.js lib/*.test.js scripts/*.test.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "icons": "node scripts/generate-icons.js",
    "exe": "npm run electron:build",
    "electron:dev": "node scripts/run-electron-dev.js",
    "electron:build": "npm run icons && npm run build && node scripts/prepare-standalone.js && electron-builder --win --publish never",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-signed-release.ps1"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "next": "16.3.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.zambudio.dashboard-uso-apis",
    "productName": "Dashboard Uso APIs",
    "copyright": "Copyright (c) 2026 Pedro Zambudio",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "electron/**/*",
      "assets/app-icon.png",
      "assets/app-icon.ico",
      "!electron/**/*.test.js",
      "!node_modules/next/**/*",
      "!node_modules/@next/**/*",
      "!node_modules/@img/**/*",
      "!node_modules/@swc/**/*",
      "!node_modules/playwright/**/*",
      "!node_modules/playwright-core/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/scheduler/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/styled-jsx/**/*",
      "!node_modules/caniuse-lite/**/*"
    ],
    "extraResources": [
      {
        "from": "build/standalone-bundle",
        "to": "standalone-bundle"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  }
}
